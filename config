# nginx addon configuration; sourced by auto/configure with POSIX sh.

ngx_addon_name=ngx_http_cache_purge_module

if [ "$HTTP" = NO ] || [ "$HTTP_CACHE" = NO ]; then
    echo "ngx_http_cache_purge_module requires HTTP cache support"
    exit 1
fi
if [ "$NGX_PLATFORM" = win32 ]; then
    echo "ngx_http_cache_purge_module currently requires Linux"
    exit 1
fi
if [ -z "$CACHE_PURGE_ROCKSDB_LIB_DIR" ]; then
    echo "set CACHE_PURGE_ROCKSDB_LIB_DIR to the CMake backend build directory"
    exit 1
fi
for archive in index rocksdb; do
    case "$archive" in
        index) file=libngx_http_cache_purge_index.a ;;
        rocksdb) file=libngx_http_cache_rocksdb.a ;;
    esac
    if [ ! -f "$CACHE_PURGE_ROCKSDB_LIB_DIR/$file" ]; then
        echo "missing cache purge backend archive: $CACHE_PURGE_ROCKSDB_LIB_DIR/$file"
        exit 1
    fi
done

CACHE_PURGE_LIBS="$CACHE_PURGE_ROCKSDB_LIB_DIR/libngx_http_cache_purge_index.a"
CACHE_ROCKSDB_LIBS="$CACHE_PURGE_ROCKSDB_LIB_DIR/libngx_http_cache_rocksdb.a ${CACHE_PURGE_ROCKSDB_LIBS:--lrocksdb -lstdc++ -lm -pthread}"
CACHE_PURGE_SRCS="$ngx_addon_dir/ngx_http_cache_purge_module.c \
 $ngx_addon_dir/ngx_http_cache_purge_request.c \
 $ngx_addon_dir/ngx_http_cache_purge_runtime.c \
 $ngx_addon_dir/ngx_http_cache_purge_files.c"
CACHE_PURGE_DEPS="$ngx_addon_dir/ngx_http_cache_purge.h \
 $ngx_addon_dir/ngx_http_cache_purge_internal.h \
 $ngx_addon_dir/rocksdb/ngx_http_cache_rocksdb.h"

if [ -n "$ngx_module_link" ]; then
    ngx_module_type=HTTP
    ngx_module_name=ngx_http_cache_key_module
    ngx_module_incs=
    ngx_module_srcs="$ngx_addon_dir/key/ngx_http_cache_key_module.c"
    ngx_module_deps=
    ngx_module_libs=
    . auto/module

    ngx_module_type=HTTP
    ngx_module_name=ngx_http_cache_rocksdb_module
    ngx_module_incs="$ngx_addon_dir"
    ngx_module_srcs="$ngx_addon_dir/rocksdb/ngx_http_cache_rocksdb_module.c"
    ngx_module_deps="$ngx_addon_dir/rocksdb/ngx_http_cache_rocksdb.h"
    ngx_module_libs="$CACHE_ROCKSDB_LIBS"
    . auto/module

    ngx_module_type=HTTP_INIT_FILTER
    ngx_module_name=ngx_http_cache_purge_module
    ngx_module_order=ngx_http_cache_purge_module
    ngx_module_incs="$ngx_addon_dir"
    ngx_module_srcs="$CACHE_PURGE_SRCS"
    ngx_module_deps="$CACHE_PURGE_DEPS"
    ngx_module_libs="$CACHE_PURGE_LIBS -pthread"
    . auto/module
else
    HTTP_MODULES="$HTTP_MODULES ngx_http_cache_key_module ngx_http_cache_rocksdb_module"
    HTTP_INIT_FILTER_MODULES="$HTTP_INIT_FILTER_MODULES ngx_http_cache_purge_module"
    HTTP_INCS="$HTTP_INCS $ngx_addon_dir"
    NGX_ADDON_SRCS="$NGX_ADDON_SRCS $ngx_addon_dir/key/ngx_http_cache_key_module.c $ngx_addon_dir/rocksdb/ngx_http_cache_rocksdb_module.c $CACHE_PURGE_SRCS"
    NGX_ADDON_DEPS="$NGX_ADDON_DEPS $CACHE_PURGE_DEPS"
    CORE_LIBS="$CORE_LIBS $CACHE_PURGE_LIBS $CACHE_ROCKSDB_LIBS"
fi

have=NGX_HTTP_CACHE_PURGE_MODULE . auto/have
