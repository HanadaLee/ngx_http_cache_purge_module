# NGINX addon configuration; sourced by auto/configure with POSIX sh.

ngx_addon_name=ngx_http_cache_purge_module

if [ "$HTTP" = NO ] || [ "$HTTP_CACHE" = NO ]; then
    echo "ngx_http_cache_purge_module requires HTTP cache support"
    exit 1
fi

if [ "$USE_THREADS" != YES ]; then
    echo "ngx_http_cache_purge_module requires --with-threads for file proof reads"
    exit 1
fi

if [ -z "$CACHE_PURGE_ROCKSDB_LIB_DIR" ]; then
    echo "ngx_http_cache_purge_module requires CACHE_PURGE_ROCKSDB_LIB_DIR"
    echo "build the RocksDB and purge archives with CMake before configuring nginx"
    exit 1
fi

# Admission and key guards require complex-value script status propagation.
ngx_feature="nginx cache script status support (1.31.7+)"
ngx_feature_name=
ngx_feature_run=no
ngx_feature_incs='#include <nginx.h>
                  #if nginx_version < 1031007
                  #error nginx 1.31.7 or newer is required
                  #endif'
ngx_feature_path="src/core $NGX_OBJS"
ngx_feature_libs=
ngx_feature_test='return 0;'
. auto/feature
if [ "$ngx_found" != yes ]; then
    echo "ngx_http_cache_purge_module requires nginx 1.31.7 or newer"
    exit 1
fi

# Mirror the enabled upstream protocols in the module's compile guards.
if [ "$HTTP_PROXY" = "YES" ]; then
    have=NGX_HTTP_PROXY . auto/have
fi

if [ "$HTTP_FASTCGI" = "YES" ]; then
    have=NGX_HTTP_FASTCGI . auto/have
fi

if [ "$HTTP_SCGI" = "YES" ]; then
    have=NGX_HTTP_SCGI . auto/have
fi

if [ "$HTTP_UWSGI" = "YES" ]; then
    have=NGX_HTTP_UWSGI . auto/have
fi

CACHE_PURGE_SRCS="$ngx_addon_dir/ngx_http_cache_purge_module.c \
                  $ngx_addon_dir/ngx_http_cache_purge_request.c \
                  $ngx_addon_dir/ngx_http_cache_purge_runtime.c"
CACHE_PURGE_DEPS="$ngx_addon_dir/ngx_http_cache_purge.h"

# nginx compiles the HTTP sources as C and links the embedded backend.
CACHE_PURGE_LIBS=
CACHE_ROCKSDB_LIBS=
if [ "$NGX_PLATFORM" = win32 ]; then
    echo "cache purge persistent runtime requires Linux"
    exit 1
fi
CACHE_ROCKSDB_LIBS="$CACHE_PURGE_ROCKSDB_LIB_DIR/libngx_http_cache_rocksdb.a"
if [ ! -f "$CACHE_ROCKSDB_LIBS" ]; then
    echo "missing cache RocksDB archive: $CACHE_ROCKSDB_LIBS"
    exit 1
fi
CACHE_ROCKSDB_LIBS="$CACHE_ROCKSDB_LIBS ${CACHE_PURGE_ROCKSDB_LIBS:--lrocksdb -lcrypto -lstdc++ -lm -pthread}"
for archive in component files index; do
    if [ ! -f "$CACHE_PURGE_ROCKSDB_LIB_DIR/libngx_http_cache_purge_${archive}.a" ]; then
        echo "missing cache purge archive: $CACHE_PURGE_ROCKSDB_LIB_DIR/libngx_http_cache_purge_${archive}.a"
        exit 1
    fi
    CACHE_PURGE_LIBS="$CACHE_PURGE_LIBS $CACHE_PURGE_ROCKSDB_LIB_DIR/libngx_http_cache_purge_${archive}.a"
done
CACHE_PURGE_LIBS="$CACHE_PURGE_LIBS -lcrypto -lm -pthread"
ngx_feature="cache purge persistent runtime libraries"
ngx_feature_name=NGX_HTTP_CACHE_PURGE_ROCKSDB
ngx_feature_run=no
# The executor uses ordinary nginx worker init/exit callbacks.
ngx_feature_incs='#include "ngx_http_cache_purge_internal.h"
                  #if !defined(__linux__)
                  #error Linux is required
                  #endif'
ngx_feature_path="src/core src/event src/event/modules src/os/unix $NGX_OBJS $ngx_addon_dir"
ngx_feature_libs="$CACHE_PURGE_LIBS $CACHE_ROCKSDB_LIBS"
ngx_feature_test='ngx_http_cache_purge_component_options_t o;
                  ngx_http_cache_rocksdb_bytes_t empty = { 0, 0 };
                  ngx_http_cache_purge_component_options(&o);
                  ngx_http_cache_rocksdb_reader_create(0, 1, 0, 0);
                  ngx_http_cache_purge_object_open(0, 0, 0, 0, empty,
                                                   0, 0, 0);
                  ngx_http_cache_purge_file_proof_read_selected(-1,
                                                               empty, 0, 0);
                  if (o.abi != ngx_http_cache_purge_component_abi_13()) return 1;
                  if (ngx_http_cache_purge_index_schema_14() != 14) return 1;
                  if (ngx_http_cache_purge_control_abi_6() != 6) return 1;'
. auto/feature
if [ "$ngx_found" != yes ]; then
    echo "cache purge persistent runtime libraries could not link"
    exit 1
fi
if [ -n "$ngx_module_link" ]; then
    ngx_module_type=HTTP
    ngx_module_name=ngx_http_cache_rocksdb_module
    ngx_module_incs="$ngx_addon_dir"
    ngx_module_srcs="$ngx_addon_dir/rocksdb/ngx_http_cache_rocksdb_module.c"
    ngx_module_deps="$ngx_addon_dir/rocksdb/ngx_http_cache_rocksdb.h"
    ngx_module_libs="$CACHE_ROCKSDB_LIBS"
    . auto/module
else
    HTTP_MODULES="$HTTP_MODULES ngx_http_cache_rocksdb_module"
    NGX_ADDON_SRCS="$NGX_ADDON_SRCS $ngx_addon_dir/rocksdb/ngx_http_cache_rocksdb_module.c"
    NGX_ADDON_DEPS="$NGX_ADDON_DEPS $ngx_addon_dir/rocksdb/ngx_http_cache_rocksdb.h"
    CORE_LIBS="$CORE_LIBS $CACHE_ROCKSDB_LIBS"
fi
CACHE_PURGE_DEPS="$CACHE_PURGE_DEPS $ngx_addon_dir/ngx_http_cache_purge_internal.h $ngx_addon_dir/rocksdb/ngx_http_cache_rocksdb.h"

# Admission precedes slice and conditional header-filter side effects.
if [ -n "$ngx_module_link" ]; then
    ngx_module_type=HTTP_INIT_FILTER
    ngx_module_name="$ngx_addon_name ngx_http_cache_purge_index_module"
    ngx_module_order="$ngx_module_name"
    ngx_module_incs="$ngx_addon_dir"
    ngx_module_srcs="$CACHE_PURGE_SRCS"
    ngx_module_deps="$CACHE_PURGE_DEPS"
    ngx_module_libs="$CACHE_PURGE_LIBS"
    . auto/module
else
    HTTP_MODULES="$HTTP_MODULES $ngx_addon_name"
    HTTP_INIT_FILTER_MODULES="$HTTP_INIT_FILTER_MODULES ngx_http_cache_purge_index_module"
    HTTP_INCS="$HTTP_INCS $ngx_addon_dir"
    NGX_ADDON_SRCS="$NGX_ADDON_SRCS $CACHE_PURGE_SRCS"
    NGX_ADDON_DEPS="$NGX_ADDON_DEPS $CACHE_PURGE_DEPS"
    CORE_LIBS="$CORE_LIBS $CACHE_PURGE_LIBS"
fi

have=NGX_HTTP_CACHE_PURGE_MODULE . auto/have

echo "  + ngx_http_cache_purge module added"
